# OpenRouter is used only by live search/Ask. Local wiki rebuilds need no API key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Where the QSS-M checkout lives. Both default to ../QSS-M.
QSSM_DIR=../QSS-M
KNOWLEDGE_SOURCE_QSSM=../QSS-M

# Live Ask server
HOST=127.0.0.1
PORT=3012
PUBLIC_URL=http://localhost:3012
# Set to 1 behind nginx so rate limits see the real client address.
TRUST_PROXY=0
# Allow a static copy on another origin (e.g. GitHub Pages) to call /api/ask.
ALLOWED_ORIGIN=
ASK_DAILY_BUDGET_USD=1
ASK_PER_IP_PER_10_MIN=8
